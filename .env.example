# Tandem Server Configuration
PORT=3001

# Initial Workspace Bootstrap
# - Used to seed users.json on first launch
# - When set, also re-syncs all local user passwords on every server start (local DX)
# - If left empty on first launch, Tandem generates a random password and prints it once to stdout
TANDEM_OWNER_EMAIL=dev@tandem.local
TANDEM_INITIAL_PASSWORD=tandem-dev

# Optional Cloud Shipping Defaults (leave blank until you link your own owned Vercel project/domain)
GITHUB_REPO_PATH=josecarlospm/tandem-dev
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_NAME=
VERCEL_PRODUCTION_DOMAIN=
