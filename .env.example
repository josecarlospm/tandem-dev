# Tandem Server Configuration
PORT=3001

# Initial Workspace Bootstrap (used only on first launch when users.json does not exist)
# If TANDEM_INITIAL_PASSWORD is left empty, Tandem generates a random password and prints it once to stdout.
TANDEM_OWNER_EMAIL=dev@tandem.local
TANDEM_INITIAL_PASSWORD=

# Optional Cloud Shipping Defaults (leave blank until you link your own owned Vercel project/domain)
GITHUB_REPO_PATH=josecarlospm/tandem-dev
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_NAME=
VERCEL_PRODUCTION_DOMAIN=
